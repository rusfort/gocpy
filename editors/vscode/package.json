{
  "name": "gocpy",
  "displayName": "Gocpy",
  "description": "Gocpy language support: rich semantic highlighting, IntelliSense, code navigation across packages and Go code, diagnostics while typing, and the Gocpy Dark theme.",
  "version": "0.3.1",
  "publisher": "rusfort",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0B1020",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rusfort/gocpy"
  },
  "homepage": "https://rusfort.github.io/gocpy/",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Themes",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "gocpy",
    "go",
    "c",
    "python",
    "compiler",
    "language server",
    "lsp",
    "intellisense",
    "syntax highlighting",
    "snippets"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:gocpy",
    "workspaceContains:**/gocpy.yml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "gocpy",
        "aliases": [
          "Gocpy",
          "gocpy"
        ],
        "extensions": [
          ".gocpy"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/gocpy-file.svg",
          "dark": "./icons/gocpy-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "gocpy",
        "scopeName": "source.gocpy",
        "path": "./syntaxes/gocpy.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Gocpy Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/gocpy-dark-color-theme.json"
      }
    ],
    "snippets": [
      {
        "language": "gocpy",
        "path": "./snippets/gocpy.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "var",
        "superType": "variable",
        "description": "Variable"
      },
      {
        "id": "field",
        "superType": "property",
        "description": "Struct field"
      },
      {
        "id": "fieldDecl",
        "superType": "property",
        "description": "Field declaration"
      },
      {
        "id": "label",
        "superType": "label",
        "description": "Label"
      },
      {
        "id": "funcDecl",
        "superType": "function",
        "description": "Function declaration"
      },
      {
        "id": "funcCall",
        "superType": "function",
        "description": "Function call"
      },
      {
        "id": "funcMethod",
        "superType": "method",
        "description": "Method"
      },
      {
        "id": "funcBuiltin",
        "superType": "function",
        "description": "Built-in function"
      },
      {
        "id": "funcStd",
        "superType": "function",
        "description": "Package function"
      },
      {
        "id": "funcOperator",
        "superType": "operator",
        "description": "Operator method"
      },
      {
        "id": "pkgName",
        "superType": "namespace",
        "description": "Package name"
      },
      {
        "id": "pkgDecl",
        "superType": "namespace",
        "description": "Package declaration"
      },
      {
        "id": "pkgMember",
        "superType": "variable",
        "description": "Package constant or variable"
      },
      {
        "id": "constUser",
        "superType": "variable",
        "description": "Constant"
      },
      {
        "id": "constBool",
        "superType": "keyword",
        "description": "true / false"
      },
      {
        "id": "constNil",
        "superType": "keyword",
        "description": "nil"
      },
      {
        "id": "typeBuiltin",
        "superType": "type",
        "description": "Built-in type"
      },
      {
        "id": "typeError",
        "superType": "type",
        "description": "error / Exception"
      },
      {
        "id": "typeUser",
        "superType": "type",
        "description": "User-defined type"
      },
      {
        "id": "typeStd",
        "superType": "type",
        "description": "Standard library type"
      },
      {
        "id": "typeParam",
        "superType": "typeParameter",
        "description": "Type parameter"
      },
      {
        "id": "typeConstraint",
        "superType": "interface",
        "description": "Generic constraint"
      },
      {
        "id": "unsafeFunc",
        "superType": "function",
        "description": "Function available in unsafe blocks"
      },
      {
        "id": "unsafeCast",
        "superType": "type",
        "description": "Pointer cast in an unsafe block"
      },
      {
        "id": "opPtr",
        "superType": "operator",
        "description": "Pointer operators * and &"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "gocpy",
        "scopes": {
          "var": [
            "variable.other.gocpy"
          ],
          "field": [
            "variable.other.property.gocpy"
          ],
          "fieldDecl": [
            "variable.other.property.gocpy"
          ],
          "label": [
            "entity.name.label.gocpy"
          ],
          "funcDecl": [
            "entity.name.function.gocpy"
          ],
          "funcCall": [
            "entity.name.function.call.gocpy"
          ],
          "funcMethod": [
            "entity.name.function.method.gocpy"
          ],
          "funcBuiltin": [
            "support.function.builtin.gocpy"
          ],
          "funcStd": [
            "support.function.gocpy"
          ],
          "funcOperator": [
            "entity.name.function.operator.gocpy"
          ],
          "pkgName": [
            "entity.name.namespace.gocpy"
          ],
          "pkgDecl": [
            "entity.name.namespace.gocpy"
          ],
          "pkgMember": [
            "variable.other.constant.gocpy"
          ],
          "constUser": [
            "variable.other.constant.gocpy"
          ],
          "constBool": [
            "constant.language.boolean.gocpy"
          ],
          "constNil": [
            "constant.language.nil.gocpy"
          ],
          "typeBuiltin": [
            "support.type.builtin.gocpy"
          ],
          "typeError": [
            "support.type.error.gocpy"
          ],
          "typeUser": [
            "entity.name.type.gocpy"
          ],
          "typeStd": [
            "support.type.gocpy"
          ],
          "typeParam": [
            "entity.name.type.parameter.gocpy"
          ],
          "typeConstraint": [
            "support.type.constraint.gocpy"
          ],
          "unsafeFunc": [
            "support.function.unsafe.gocpy"
          ],
          "unsafeCast": [
            "entity.name.type.gocpy"
          ],
          "opPtr": [
            "keyword.operator.pointer.gocpy"
          ]
        }
      }
    ],
    "colors": [
      {
        "id": "gocpy.unsafeBackground",
        "description": "Background of `unsafe { … }` blocks.",
        "defaults": {
          "dark": "#2d1f22",
          "light": "#fdecee",
          "highContrast": "#3a1d22",
          "highContrastLight": "#fdecee"
        }
      }
    ],
    "configuration": {
      "title": "Gocpy",
      "properties": {
        "gocpy.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `gocpy` executable. When empty, it is looked up in `PATH`, `/opt/homebrew/bin`, `/usr/local/bin` and `~/go/bin`."
        },
        "gocpy.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable the language server (`gocpy lsp`): navigation, references, completion, diagnostics and semantic highlighting."
        },
        "gocpy.unsafeHighlight": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Highlight the background of `unsafe { … }` blocks."
        },
        "gocpy.suggestTheme": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer the Gocpy Dark theme the first time a `.gocpy` file is opened."
        },
        "gocpy.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "markdownDescription": "Trace the communication between VS Code and the language server."
        }
      }
    },
    "commands": [
      {
        "command": "gocpy.restartServer",
        "title": "Restart Language Server",
        "category": "Gocpy"
      },
      {
        "command": "gocpy.run",
        "title": "Run Package",
        "category": "Gocpy",
        "icon": "$(play)"
      },
      {
        "command": "gocpy.build",
        "title": "Build Package",
        "category": "Gocpy"
      },
      {
        "command": "gocpy.check",
        "title": "Check Package",
        "category": "Gocpy"
      },
      {
        "command": "gocpy.useTheme",
        "title": "Use Gocpy Dark Theme",
        "category": "Gocpy"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "gocpy.run",
          "when": "resourceLangId == gocpy",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "gocpy.run",
          "when": "editorLangId == gocpy"
        },
        {
          "command": "gocpy.build",
          "when": "editorLangId == gocpy"
        },
        {
          "command": "gocpy.check",
          "when": "editorLangId == gocpy"
        }
      ]
    },
    "configurationDefaults": {
      "[gocpy]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.js --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --minify",
    "package": "npm run build && vsce package --no-dependencies",
    "test:grammar": "node test/grammar.js",
    "test": "npm run build && node test/run.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "bugs": {
    "url": "https://github.com/rusfort/gocpy/issues"
  },
  "qna": "https://github.com/rusfort/gocpy/discussions"
}
