{
  "Program": {
    "prefix": "main",
    "body": [
      "package main",
      "",
      "import \"std/fmt\"",
      "",
      "func main() {",
      "\tfmt.Println(\"${1:Hello, Gocpy}\")$0",
      "}"
    ],
    "description": "Package main with a main function"
  },
  "Method": {
    "prefix": "meth",
    "body": [
      "func (${1:r} ${2:*T}) ${3:Name}(${4}) ${5}{",
      "\t$0",
      "}"
    ],
    "description": "Method of a type"
  },
  "Function with @throws": {
    "prefix": "tfunc",
    "body": [
      "@throws",
      "func ${1:name}(${2}) ${3}{",
      "\t$0",
      "}"
    ],
    "description": "Function that may throw exceptions"
  },
  "Overload": {
    "prefix": "ofunc",
    "body": [
      "@overload",
      "func ${1:name}(${2}) ${3}{",
      "\t$0",
      "}"
    ],
    "description": "Overloaded function (@overload is required)"
  },
  "Operator": {
    "prefix": "opfunc",
    "body": [
      "func (${1:a} ${2:T}) ${3:+}(${4:b} ${2:T}) ${2:T} {",
      "\t$0",
      "}"
    ],
    "description": "Operator method"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "type ${1:Name} struct {",
      "\t${2:Field} ${3:int}",
      "}"
    ],
    "description": "Struct type"
  },
  "Interface": {
    "prefix": "iface",
    "body": [
      "type ${1:Name} interface {",
      "\t${2:Method}() ${3:string}",
      "}"
    ],
    "description": "Interface type"
  },
  "Generic function": {
    "prefix": "gfunc",
    "body": [
      "func ${1:Name}[${2:T} ${3:any}](${4:x} ${2:T}) ${2:T} {",
      "\t$0",
      "}"
    ],
    "description": "Function with a type parameter"
  },
  "For loop": {
    "prefix": "fori",
    "body": [
      "for ${1:i} := 0; ${1:i} < ${2:n}; ${1:i}++ {",
      "\t$0",
      "}"
    ],
    "description": "for i := 0; i < n; i++"
  },
  "For-in loop": {
    "prefix": "forin",
    "body": [
      "for ${1:i}, ${2:x} in ${3:xs} {",
      "\t$0",
      "}"
    ],
    "description": "Loop with index and value"
  },
  "Error check": {
    "prefix": "iferr",
    "body": [
      "if err != nil {",
      "\treturn ${1:err}",
      "}"
    ],
    "description": "if err != nil"
  },
  "try / catch / finally": {
    "prefix": "tcf",
    "body": [
      "try {",
      "\t$1",
      "} catch ${2:e} {",
      "\t$3",
      "} finally {",
      "\t$0",
      "}"
    ],
    "description": "Full exception handling block"
  },
  "List comprehension": {
    "prefix": "comp",
    "body": [
      "[${1:x} for ${1:x} in ${2:xs} if ${3:cond}]"
    ],
    "description": "List comprehension"
  },
  "f-string": {
    "prefix": "fs",
    "body": [
      "f\"${1:text} {${2:expr}}\""
    ],
    "description": "Formatted string"
  },
  "Ignore unused": {
    "prefix": "ignore",
    "body": [
      "//gocpy:ignore:unused"
    ],
    "description": "Suppress the unused declaration error"
  }
}
