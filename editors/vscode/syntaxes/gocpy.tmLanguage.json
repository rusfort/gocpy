{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Gocpy",
  "scopeName": "source.gocpy",
  "fileTypes": ["gocpy"],
  "patterns": [
    { "include": "#directive" },
    { "include": "#comments" },
    { "include": "#annotations" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "directive": {
      "match": "//gocpy:[A-Za-z0-9_:.-]+",
      "name": "keyword.other.directive.gocpy"
    },
    "comments": {
      "patterns": [
        { "begin": "/\\*", "end": "\\*/", "name": "comment.block.gocpy" },
        { "match": "//.*$", "name": "comment.line.double-slash.gocpy" }
      ]
    },
    "annotations": {
      "match": "@[A-Za-z_][A-Za-z0-9_]*",
      "name": "storage.type.annotation.gocpy"
    },
    "strings": {
      "patterns": [
        {
          "begin": "f\"",
          "end": "\"",
          "name": "string.quoted.double.interpolated.gocpy",
          "patterns": [
            { "match": "\\\\.", "name": "constant.character.escape.gocpy" },
            {
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.gocpy" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.gocpy" } },
              "name": "meta.interpolation.gocpy",
              "patterns": [{ "include": "$self" }]
            }
          ]
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.gocpy",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.gocpy" }]
        },
        { "begin": "`", "end": "`", "name": "string.quoted.raw.gocpy" },
        { "match": "'(\\\\.|[^'\\\\])'", "name": "string.quoted.single.rune.gocpy" }
      ]
    },
    "numbers": {
      "match": "\\b(0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9]+)?)\\b",
      "name": "constant.numeric.gocpy"
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(if|else|for|in|switch|case|default|fallthrough|break|continue|return|select|go|defer|try|catch|finally|throw)\\b",
          "name": "keyword.control.gocpy"
        },
        {
          "match": "\\b(package|import|func|var|const|type|struct|interface|map|chan|unsafe)\\b",
          "name": "keyword.other.gocpy"
        }
      ]
    },
    "types": {
      "match": "\\b(bool|string|byte|rune|any|error|uintptr|int|int8|int16|int32|int64|uint|uint8|uint16|uint32|uint64|float32|float64|comparable)\\b",
      "name": "storage.type.gocpy"
    },
    "constants": {
      "match": "\\b(true|false|nil|iota)\\b",
      "name": "constant.language.gocpy"
    },
    "functions": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.gocpy" } }
    },
    "operators": {
      "match": ":=|\\.\\.\\.|&&|\\|\\||<-|[+\\-*/%&|^<>=!?~]=?",
      "name": "keyword.operator.gocpy"
    }
  }
}
