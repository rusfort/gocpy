// Package strings implements functions to manipulate UTF-8 encoded strings.
package strings

// Contains reports whether substr is within s.
func Contains(s string, substr string) bool {
	return Index(s, substr) >= 0
}

// ContainsRune reports whether the rune r is within s.
func ContainsRune(s string, r rune) bool {
	return IndexRune(s, r) >= 0
}

// ContainsAny reports whether any rune of chars is within s.
func ContainsAny(s string, chars string) bool {
	return IndexAny(s, chars) >= 0
}

// HasPrefix reports whether s begins with prefix.
func HasPrefix(s string, prefix string) bool {
	return len(s) >= len(prefix) && s[:len(prefix)] == prefix
}

// HasSuffix reports whether s ends with suffix.
func HasSuffix(s string, suffix string) bool {
	return len(s) >= len(suffix) && s[len(s)-len(suffix):] == suffix
}

// Index returns the index of the first instance of substr in s, or -1.
func Index(s string, substr string) int {
	k := len(substr)
	if k == 0 {
		return 0
	}
	last := len(s) - k
	first := substr[0]
	for i := 0; i <= last; i++ {
		if s[i] == first && s[i:i+k] == substr {
			return i
		}
	}
	return -1
}

// LastIndex returns the index of the last instance of substr in s, or -1.
func LastIndex(s string, substr string) int {
	k := len(substr)
	if k == 0 {
		return len(s)
	}
	for i := len(s) - k; i >= 0; i-- {
		if s[i:i+k] == substr {
			return i
		}
	}
	return -1
}

// IndexByte returns the index of the first instance of c in s, or -1.
func IndexByte(s string, c byte) int {
	for i := 0; i < len(s); i++ {
		if s[i] == c {
			return i
		}
	}
	return -1
}

// LastIndexByte returns the index of the last instance of c in s, or -1.
func LastIndexByte(s string, c byte) int {
	for i := len(s) - 1; i >= 0; i-- {
		if s[i] == c {
			return i
		}
	}
	return -1
}

// IndexRune returns the index of the first instance of the rune r, or -1.
func IndexRune(s string, r rune) int {
	for i, c in s {
		if c == r {
			return i
		}
	}
	return -1
}

// IndexAny returns the index of the first rune of s that is in chars, or -1.
func IndexAny(s string, chars string) int {
	for i, c in s {
		if IndexRune(chars, c) >= 0 {
			return i
		}
	}
	return -1
}

// Count counts the non-overlapping instances of substr in s. An empty
// substr gives the number of runes plus one.
func Count(s string, substr string) int {
	if len(substr) == 0 {
		return RuneCount(s) + 1
	}
	total := 0
	rest := s
	for {
		i := Index(rest, substr)
		if i < 0 {
			return total
		}
		total++
		rest = rest[i+len(substr):]
	}
}

// RuneCount returns the number of runes in s.
func RuneCount(s string) int {
	total := 0
	for i := 0; i < len(s); i++ {
		if s[i]&0xC0 != 0x80 {
			total++
		}
	}
	return total
}

// Split slices s into all substrings separated by sep. An empty sep splits
// after each UTF-8 sequence.
func Split(s string, sep string) []string {
	return SplitN(s, sep, -1)
}

// SplitN is Split with a limit: at most limit substrings are returned (the
// last one is the unsplit remainder); limit < 0 means no limit, 0 returns nil.
func SplitN(s string, sep string, limit int) []string {
	if limit == 0 {
		return nil
	}
	var out []string
	if sep == "" {
		for i, c in s {
			if limit > 0 && len(out) == limit-1 {
				out = append(out, s[i:])
				return out
			}
			out = append(out, string(c))
		}
		return out
	}
	rest := s
	for limit < 0 || len(out) < limit-1 {
		i := Index(rest, sep)
		if i < 0 {
			break
		}
		out = append(out, rest[:i])
		rest = rest[i+len(sep):]
	}
	return append(out, rest)
}

// SplitAfter slices s into all substrings after each instance of sep.
func SplitAfter(s string, sep string) []string {
	if sep == "" {
		return Split(s, sep)
	}
	var out []string
	rest := s
	for {
		i := Index(rest, sep)
		if i < 0 {
			break
		}
		out = append(out, rest[:i+len(sep)])
		rest = rest[i+len(sep):]
	}
	return append(out, rest)
}

func isSpace(c byte) bool {
	return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f'
}

// Fields splits s around runs of white space.
func Fields(s string) []string {
	var out []string
	start := -1
	for i := 0; i < len(s); i++ {
		if isSpace(s[i]) {
			if start >= 0 {
				out = append(out, s[start:i])
				start = -1
			}
		} else if start < 0 {
			start = i
		}
	}
	if start >= 0 {
		out = append(out, s[start:])
	}
	return out
}

// FieldsFunc splits s at each run of runes c satisfying f(c).
func FieldsFunc(s string, f func(rune) bool) []string {
	var out []string
	start := -1
	for i, c in s {
		if f(c) {
			if start >= 0 {
				out = append(out, s[start:i])
				start = -1
			}
		} else if start < 0 {
			start = i
		}
	}
	if start >= 0 {
		out = append(out, s[start:])
	}
	return out
}

// Join concatenates the elements of elems, placing sep between them.
func Join(elems []string, sep string) string {
	var b Builder
	for i, e in elems {
		if i > 0 {
			b.WriteString(sep)
		}
		b.WriteString(e)
	}
	return b.String()
}

// Repeat returns count copies of s.
func Repeat(s string, count int) string {
	var b Builder
	for i := 0; i < count; i++ {
		b.WriteString(s)
	}
	return b.String()
}

// Replace returns s with the first n non-overlapping instances of old
// replaced by repl (all of them if n < 0).
func Replace(s string, old string, repl string, n int) string {
	if n == 0 || old == repl {
		return s
	}
	var b Builder
	done := 0
	if old == "" {
		for i, c in s {
			if n < 0 || done < n {
				b.WriteString(repl)
				done++
			} else {
				b.WriteString(s[i:])
				return b.String()
			}
			b.WriteRune(c)
		}
		if n < 0 || done < n {
			b.WriteString(repl)
		}
		return b.String()
	}
	rest := s
	for n < 0 || done < n {
		i := Index(rest, old)
		if i < 0 {
			break
		}
		b.WriteString(rest[:i])
		b.WriteString(repl)
		rest = rest[i+len(old):]
		done++
	}
	b.WriteString(rest)
	return b.String()
}

// ReplaceAll replaces all non-overlapping instances of old with repl.
func ReplaceAll(s string, old string, repl string) string {
	return Replace(s, old, repl, -1)
}

// TrimSpace removes leading and trailing white space.
func TrimSpace(s string) string {
	i := 0
	j := len(s)
	for i < j && isSpace(s[i]) {
		i++
	}
	for j > i && isSpace(s[j-1]) {
		j--
	}
	return s[i:j]
}

// TrimLeft removes leading runes contained in cutset.
func TrimLeft(s string, cutset string) string {
	for i, c in s {
		if IndexRune(cutset, c) < 0 {
			return s[i:]
		}
	}
	return ""
}

// TrimRight removes trailing runes contained in cutset.
func TrimRight(s string, cutset string) string {
	end := 0
	for i, c in s {
		if IndexRune(cutset, c) < 0 {
			end = i + len(string(c))
		}
	}
	return s[:end]
}

// Trim removes leading and trailing runes contained in cutset.
func Trim(s string, cutset string) string {
	return TrimRight(TrimLeft(s, cutset), cutset)
}

// TrimFunc removes leading and trailing runes c satisfying f(c).
func TrimFunc(s string, f func(rune) bool) string {
	start := len(s)
	end := 0
	for i, c in s {
		if !f(c) {
			if start == len(s) {
				start = i
			}
			end = i + len(string(c))
		}
	}
	if end == 0 {
		return ""
	}
	return s[start:end]
}

// TrimPrefix returns s without the leading prefix, if present.
func TrimPrefix(s string, prefix string) string {
	if HasPrefix(s, prefix) {
		return s[len(prefix):]
	}
	return s
}

// TrimSuffix returns s without the trailing suffix, if present.
func TrimSuffix(s string, suffix string) string {
	if HasSuffix(s, suffix) {
		return s[:len(s)-len(suffix)]
	}
	return s
}

// Cut slices s around the first instance of sep.
func Cut(s string, sep string) (before string, after string, found bool) {
	i := Index(s, sep)
	if i < 0 {
		return s, "", false
	}
	return s[:i], s[i+len(sep):], true
}

// CutPrefix returns s without prefix and whether it was present.
func CutPrefix(s string, prefix string) (after string, found bool) {
	if !HasPrefix(s, prefix) {
		return s, false
	}
	return s[len(prefix):], true
}

// CutSuffix returns s without suffix and whether it was present.
func CutSuffix(s string, suffix string) (before string, found bool) {
	if !HasSuffix(s, suffix) {
		return s, false
	}
	return s[:len(s)-len(suffix)], true
}

// upperRune maps a lower-case letter (ASCII, Latin-1, Greek, Cyrillic) to
// upper case.
func upperRune(c rune) rune {
	switch {
	case c >= 'a' && c <= 'z':
		return c - 32
	case c < 0x80:
		return c
	case c == 0xB5:
		return 0x39C
	case c >= 0xE0 && c <= 0xFE && c != 0xF7:
		return c - 32
	case c == 0xFF:
		return 0x178
	case c >= 0x100 && c <= 0x17F && c != 0x130 && c != 0x131 && c != 0x138 && c != 0x149 && c != 0x17F:
		if (c >= 0x139 && c <= 0x148) || (c >= 0x179 && c <= 0x17E) {
			if c%2 == 0 {
				return c - 1
			}
			return c
		}
		if c%2 == 1 {
			return c - 1
		}
		return c
	case c == 0x3C2:
		return 0x3A3
	case c >= 0x3B1 && c <= 0x3C9:
		return c - 32
	case c >= 0x430 && c <= 0x44F:
		return c - 32
	case c >= 0x450 && c <= 0x45F:
		return c - 80
	case c >= 0x460 && c <= 0x4FF && c != 0x4C0 && c != 0x4CF && (c < 0x482 || c > 0x489):
		if c >= 0x4C1 && c <= 0x4CE {
			if c%2 == 0 {
				return c - 1
			}
			return c
		}
		if c%2 == 1 {
			return c - 1
		}
		return c
	}
	return c
}

// lowerRune maps an upper-case letter (ASCII, Latin-1, Greek, Cyrillic) to
// lower case.
func lowerRune(c rune) rune {
	switch {
	case c >= 'A' && c <= 'Z':
		return c + 32
	case c < 0x80:
		return c
	case c >= 0xC0 && c <= 0xDE && c != 0xD7:
		return c + 32
	case c == 0x178:
		return 0xFF
	case c >= 0x100 && c <= 0x17F && c != 0x130 && c != 0x131 && c != 0x138 && c != 0x149 && c != 0x17F:
		if (c >= 0x139 && c <= 0x148) || (c >= 0x179 && c <= 0x17E) {
			if c%2 == 1 {
				return c + 1
			}
			return c
		}
		if c%2 == 0 {
			return c + 1
		}
		return c
	case c >= 0x391 && c <= 0x3A9 && c != 0x3A2:
		return c + 32
	case c >= 0x410 && c <= 0x42F:
		return c + 32
	case c >= 0x400 && c <= 0x40F:
		return c + 80
	case c >= 0x460 && c <= 0x4FF && c != 0x4C0 && c != 0x4CF && (c < 0x482 || c > 0x489):
		if c >= 0x4C1 && c <= 0x4CE {
			if c%2 == 1 {
				return c + 1
			}
			return c
		}
		if c%2 == 0 {
			return c + 1
		}
		return c
	}
	return c
}

// ToUpper returns s with all letters mapped to upper case. Letters outside
// ASCII, Latin-1, Latin Extended-A, Greek and Cyrillic are kept as is.
func ToUpper(s string) string {
	var b Builder
	for _, c in s {
		b.WriteRune(upperRune(c))
	}
	return b.String()
}

// ToLower returns s with all letters mapped to lower case (same ranges as
// ToUpper).
func ToLower(s string) string {
	var b Builder
	for _, c in s {
		b.WriteRune(lowerRune(c))
	}
	return b.String()
}

// Title returns s with the first letter of each word in upper case.
func Title(s string) string {
	var b Builder
	prev := ' '
	for _, c in s {
		if prev == ' ' || prev == '\t' || prev == '\n' || prev == '-' {
			b.WriteRune(upperRune(c))
		} else {
			b.WriteRune(c)
		}
		prev = c
	}
	return b.String()
}

// EqualFold reports whether s and t are equal under simple case folding.
func EqualFold(s string, t string) bool {
	return ToLower(s) == ToLower(t)
}

// Compare returns -1, 0 or +1 comparing a and b lexicographically.
func Compare(a string, b string) int {
	if a == b {
		return 0
	}
	if a < b {
		return -1
	}
	return 1
}

// Map returns s with every rune replaced by mapping(r); negative results
// drop the rune.
func Map(mapping func(rune) rune, s string) string {
	var b Builder
	for _, c in s {
		m := mapping(c)
		if m >= 0 {
			b.WriteRune(m)
		}
	}
	return b.String()
}

// Builder builds strings efficiently. The zero value is ready to use.
type Builder struct {
	buf []byte
}

// WriteString appends s.
func (b *Builder) WriteString(s string) (int, error) {
	b.buf = append(b.buf, []byte(s)...)
	return len(s), nil
}

// Write appends p.
func (b *Builder) Write(p []byte) (int, error) {
	b.buf = append(b.buf, p...)
	return len(p), nil
}

// WriteByte appends c.
func (b *Builder) WriteByte(c byte) error {
	b.buf = append(b.buf, c)
	return nil
}

// WriteRune appends the UTF-8 encoding of r.
func (b *Builder) WriteRune(r rune) (int, error) {
	if r >= 0 && r < 0x80 {
		b.buf = append(b.buf, byte(r))
		return 1, nil
	}
	enc := string(r)
	b.buf = append(b.buf, []byte(enc)...)
	return len(enc), nil
}

// String returns the accumulated string.
func (b *Builder) String() string {
	return string(b.buf)
}

// Len returns the number of accumulated bytes.
func (b *Builder) Len() int {
	return len(b.buf)
}

// Reset empties the builder.
func (b *Builder) Reset() {
	b.buf = nil
}

// Grow reserves space for at least extra more bytes.
func (b *Builder) Grow(extra int) {
	if cap(b.buf)-len(b.buf) < extra {
		nb := make([]byte, len(b.buf), 2*cap(b.buf)+extra)
		for i := 0; i < len(b.buf); i++ {
			nb[i] = b.buf[i]
		}
		b.buf = nb
	}
}

// Reader reads from a string; it implements io.Reader.
type Reader struct {
	s   string
	off int
}

// NewReader returns a Reader reading from s.
func NewReader(s string) *Reader {
	return &Reader{s: s}
}

// Read reads up to len(p) bytes; at the end it returns 0 and io.EOF.
func (r *Reader) Read(p []byte) (int, error) {
	if r.off >= len(r.s) {
		if len(p) == 0 {
			return 0, nil
		}
		return 0, eof()
	}
	k := 0
	for k < len(p) && r.off < len(r.s) {
		p[k] = r.s[r.off]
		k++
		r.off++
	}
	return k, nil
}

// Len returns the number of unread bytes.
func (r *Reader) Len() int {
	return len(r.s) - r.off
}

@extern("gocpy_io_eof")
func eof() error
